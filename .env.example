# ── MockTest admin access server ──────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env (it is gitignored).

PORT=4000

# Supabase — same project the MockTest web app uses (Project Settings → API keys).
# SUPABASE_SECRET_KEY (sb_secret_…) is secret: server-side only, never in the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Comma-separated emails that are always super admins (bootstrap / emergency access).
SUPER_ADMIN_EMAILS=owner@example.com

# Comma-separated frontend origins allowed to call this server (CORS).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Existing MockTest API (the one the admin panel calls today for exams & questions)
# and its admin key. Requests are forwarded there after the role/domain check,
# so questions are saved exactly as before.
MAIN_API_URL=https://api.example.com
MAIN_API_ADMIN_KEY=your-admin-key

# Admin → Users & Subscriptions. Viewing always works. Changing subscriptions (extend, change plan,
# suspend, give a plan) writes to the existing `subscriptions` table and stays OFF until this is true.
ALLOW_SUBSCRIPTION_WRITES=false

# Random secret (32+ characters) used to seal the Google/Apple sign-in state and the 60-second sign-in code.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_STATE_SECRET=change-me-to-a-long-random-string

# Cashfree payment gateway (Developers → API Keys). Server-only. sandbox = test keys, production = live keys.
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_ENV=sandbox
